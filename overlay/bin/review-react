#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
. "$HERE/review-watcher-lib.sh"
rw_load_config

owner="$1"; repo="$2"; pr="$3"; review_id="$4"; state="$5"; reviewer="$6"
lock="$RW_HOME/locks/${owner}__${repo}__${pr}.lock"
mkdir -p "$RW_HOME/locks" "$RW_HOME/logs"
exec 9>"$lock"
flock -n 9 || { echo "review-react: $owner/$repo#$pr already in flight, skipping" >&2; exit 0; }

prompt="$(rw_render_playbook "$RW_HOME/playbook.md" "$repo" "$pr" "$state" "$reviewer")"
log="$RW_HOME/logs/${repo}-pr-${pr}.log"

# Headless: --remote-control needs an attended TTY and stalls in a detached tmux
# session, so run non-interactively. --verbose streams turn-by-turn to the log so
# `tail -f` shows live progress.
cmd=(timeout "$REACTION_TIMEOUT" claude -p "$prompt"
     --permission-mode bypassPermissions --verbose)

if [ "${RW_DRY_RUN:-0}" = "1" ]; then
  printf '%q ' "${cmd[@]}"; echo; exit 0
fi

wt=""
rw_react_cleanup() {
  cd /
  [ -z "$wt" ] || rw_remove_worktree "$owner" "$repo" "$wt"
}
trap rw_react_cleanup EXIT
# tmux kill-session delivers SIGHUP; route fatal signals through exit so the EXIT
# trap still runs.
trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM

wt="$(rw_prepare_worktree "$owner" "$repo" "$pr" pr)"
cd "$wt"
# `gh repo clone` of a fork makes the parent gh's default repo, so unqualified gh
# calls in the session (pr view, pr checkout, api repos/{owner}/{repo}) would act on
# the parent's PR of the same number. GH_REPO pins them to the PR's repo.
export GH_REPO="$owner/$repo"
# A named branch, so the agent's push lands on the PR. --force resets a local
# branch an earlier session left behind to the PR's current head.
gh pr checkout "$pr" --force >/dev/null 2>&1 \
  || echo "review-react: gh pr checkout failed; staying detached at the PR head" >&2

"${cmd[@]}" 2>&1 | tee -a "$log" || {
  echo "review-react: reaction on $owner/$repo#$pr failed or timed out; leaving unseen for retry" >&2
  exit 0
}

# The merge never rides on agent judgment: an agent once launched rw-merge in the
# background and exited "done" — the session teardown killed the merge, and the
# already-marked-seen review meant the watcher never came back. The agent's job ends
# at "branch current and pushed"; the harness owns the merge, and an APPROVED review
# is only seen once rw-merge itself reports success.
if [ "$state" != "APPROVED" ]; then
  rw_mark_seen "$owner" "$repo" "$pr" "$review_id"
elif "$HERE/rw-merge" "$owner" "$repo" "$pr" 2>&1 | tee -a "$log"; then
  rw_mark_seen "$owner" "$repo" "$pr" "$review_id"
else
  echo "review-react: rw-merge did not merge $owner/$repo#$pr; leaving unseen for retry" >&2
fi
